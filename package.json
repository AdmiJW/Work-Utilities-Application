{
  "name": "workplace-utilities",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node --env-file-if-exists=.env.local scripts/configure-license.mjs && ng serve",
    "build": "node --env-file-if-exists=.env.local scripts/configure-license.mjs && ng build",
    "preview": "node scripts/serve-dist.mjs",
    "image:build": "node --env-file-if-exists=.env.local scripts/build-image.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:e2e": "playwright test",
    "lint": "eslint src scripts e2e eslint.config.mjs playwright.config.ts --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:boundaries": "node scripts/verify-boundaries.mjs",
    "check": "npm run lint && npm run check:boundaries && npm run format:check && npm test && npm run build"
  },
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "vite": "8.3.5",
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "packageManager": "npm@12.2.1",
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "@primeuix/themes": "^3.1.0",
    "ag-grid-angular": "^36.2.0",
    "ag-grid-community": "^36.2.0",
    "dexie": "^4.4.7",
    "exceljs": "^4.4.0",
    "jsonc-parser": "^3.3.1",
    "monaco-editor": "^0.57.0",
    "primeng": "^22.1.4",
    "rxjs": "~7.8.0",
    "sql-formatter": "^15.9.0",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.3.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.0"
  }
}
